# .gitignore for Deep Insights Copilot
# Ignore environment files and secrets
.env
.env.*

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
venv/
.venv/
env/
ENV/
env.bak/
pip-log.txt
pip-delete-this-directory.txt

# Virtualenv
.venv/

# Byte-compiled / optimized / DLL files
*.pyc
*.pyo
*.pyd

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter notebooks
.ipynb_checkpoints

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Node / frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.pnp.js

# Docker
docker-compose.override.yml
*.local.env

# Logs
logs/
*.log

# Database files (if any local dumps)
*.sqlite3
*.db
data/
project_dataset/

# Streamlit
.streamlit/

# Secrets and keys
*.pem
*.key
secrets.json

# JetBrains
*.iml

